<group name="sysmon,sysmon_eid1_detections,windows,">

  <rule id="100001" level="0">
    <if_sid>61603, 92032</if_sid>
    <description>Monitoring Sysmon Activity</description>
  </rule>

  <rule id="100002" level="8">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.originalFileName" type="pcre2">(?i)^schtasks\.exe$</field>
    <description>Scheduled Task Utility Executed (schtasks.exe)</description>
    <mitre>
      <id>T1087, T1053.005</id>
    </mitre>
  </rule>

  <rule id="100003" level="8">
    <if_sid>100001</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)schtasks</field>
    <description>Scheduled Task Utility Executed (Command Line)</description>
    <mitre>
      <id>T1087, T1053.005</id>
    </mitre>
  </rule>

</group>

<!-- GROUP 2: Khusus Deteksi Berbasis PowerShell (SharpHound) -->
<group name="windows,powershell,">

  <rule id="100004" level="12">
    <if_sid>91809, 91837</if_sid> <!-- Disamakan dengan rule induk bawaan yang terpicu di JSON kamu -->
    <field name="win.eventdata.path" type="pcre2">(?i)SharpHound\.ps1</field>
    <description>Potential BloodHound/SharpHound Enumeration Detected via Script Path</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1087.002</id>
    </mitre>
  </rule>

  <rule id="100005" level="12">
    <if_sid>100004</if_sid>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)SharpHound|InvokeSharpHound</field>
    <description>Potential BloodHound/SharpHound Execution Detected via ScriptBlock Text</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
      <id>T1087.002</id>
    </mitre>
  </rule>

</group>